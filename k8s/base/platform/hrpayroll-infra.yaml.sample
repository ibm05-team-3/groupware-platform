# 샘플만 커밋한다. 값을 채운 뒤 hrpayroll-infra.yaml 로 저장하고 클러스터에 적용한다.
# 이 파일은 kustomization 에 없다. Argo CD Sync 로 덮어쓰지 않는다.
# postgres 는 PostgreSQL 17 과 pgvector 를 한 인스턴스에서 쓴다.
# Kafka, Elasticsearch 는 이 Secret 을 읽지 않는다.
# redis-password 를 빈 문자열로 두면 Redis AUTH 를 하지 않는다.
apiVersion: v1
kind: Secret
metadata:
  name: hrpayroll-infra
  namespace: coliving
  labels:
    app.kubernetes.io/part-of: coliving-platform
type: Opaque
stringData:
  postgres-user: ""
  postgres-password: ""
  rabbitmq-user: ""
  rabbitmq-password: ""
  redis-password: ""
  grafana-admin-user: ""
  grafana-admin-password: ""
